{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./.contracts-raw/**)",
      "Read(./**/*.key)",
      "Read(./**/master.key)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(make deploy*)",
      "Bash(make rollback*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/secret_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"", "timeout": 90 },
          { "type": "command", "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/infra_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/verify_gate.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"", "timeout": 330 }
        ]
      }
    ]
  }
}
