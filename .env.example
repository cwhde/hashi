# Required by deploy/compose/docker-compose.yml. Generate a strong unique value.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional database identity overrides.
POSTGRES_DB=hashi
POSTGRES_USER=hashi

# Optional published ports.
HASHI_ADMIN_PORT=8080
HASHI_PUBLIC_DASHBOARD_PORT=8081
HASHI_PUBLIC_STATUS_PORT=8082

# Optional unattended provider-sync key. Generate with: openssl rand -base64 32
HASHI_SERVICE_SYNC_VAULT_KEY=
