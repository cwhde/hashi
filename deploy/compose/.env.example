# Copy to .env next to compose.yaml on the Docker host. make deploy rewrites HASHI_TAG.
HASHI_TAG=latest
HASHI_ADMIN_PORT=8080
HASHI_PUBLIC_APPS_PORT=8081
HASHI_PUBLIC_STATUS_PORT=8082
# Host directory for /data (DB, backups). Must be writable by uid 65532.
HASHI_DATA_DIR=./data
HASHI_LOG_LEVEL=info
