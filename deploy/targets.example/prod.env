# Deploy target for `make deploy ENV=prod`. Copy to deploy/targets/prod.env (gitignored) and fill in.
# The Docker host is reached as: ssh $DEPLOY_SSH pct exec $DEPLOY_CT -- … (set DEPLOY_CT empty for a plain host).
DEPLOY_SSH=root@pve.example.com
DEPLOY_CT=100
DEPLOY_DIR=/srv/hashi
DEPLOY_DATA_DIR=/srv/hashi/data
DEPLOY_ADMIN_PORT=8080
DEPLOY_PUBLIC_APPS_PORT=8081
DEPLOY_PUBLIC_STATUS_PORT=8082
# Address of the Docker host as seen from DEPLOY_SSH (smoke checks run there).
DEPLOY_HOST_IP=192.0.2.10
