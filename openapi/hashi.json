  "components": {
    "schemas": {
      "AuditEventResponse": {
        "required": [
          "id",
          "category",
          "action",
          "subjectType",
          "subjectId",
          "outcome",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "subjectType": {
            "type": [
              "null",
              "string"
            ]
          },
          "subjectId": {
            "type": [
              "null",
              "string"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BootstrapAllowedResponse": {
        "required": [
          "allowed",
          "remoteIp"
        ],
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "remoteIp": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BootstrapLoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "GeneralSettingsRequest": {
        "required": [
          "rootDomain",
          "adminDomain",
          "internalUrl",
          "defaultSyncIntervalMinutes",
          "publicDashboardEnabled",
          "publicStatusEnabled",
          "theme"
        ],
        "type": "object",
        "properties": {
          "rootDomain": {
            "type": [
              "null",
              "string"
            ]
          },
          "adminDomain": {
            "type": [
              "null",
              "string"
            ]
          },
          "internalUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "defaultSyncIntervalMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "publicDashboardEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "publicStatusEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "theme": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GeneralSettingsResponse": {
        "required": [
          "rootDomain",
          "adminDomain",
          "internalUrl",
          "defaultSyncIntervalMinutes",
          "publicDashboardEnabled",
          "publicStatusEnabled",
          "theme",
          "updatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "rootDomain": {
            "type": [
              "null",
              "string"
            ]
          },
          "adminDomain": {
            "type": [
              "null",
              "string"
            ]
          },
          "internalUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "defaultSyncIntervalMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "publicDashboardEnabled": {
            "type": "boolean"
          },
          "publicStatusEnabled": {
            "type": "boolean"
          },
          "theme": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "GeneralSettingsUpdateResponse": {
        "required": [
          "updated",
          "updatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "updated": {
            "type": "boolean"
          },
          "updatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "version",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PasskeyLoginCompleteRequest": {
        "required": [
          "assertion",
          "challengeSessionId",
          "prfOutputBase64"
        ],
        "type": "object",
        "properties": {
          "assertion": { },
          "challengeSessionId": {
            "type": "string"
          },
          "prfOutputBase64": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PasskeyRegistrationCompleteRequest": {
        "required": [
          "attestation",
          "challengeSessionId",
          "nickname",
          "clientReportsPrfSupported"
        ],
        "type": "object",
        "properties": {
          "attestation": { },
          "challengeSessionId": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "clientReportsPrfSupported": {
            "type": "boolean"
          }
        }
      },
      "SecretDescriptorResponse": {
        "required": [
          "id",
          "purpose",
          "label",
          "createdAtUtc",
          "updatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SecretStoreRequest": {
        "required": [
          "label",
          "purpose",
          "plaintextBase64"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "plaintextBase64": {
            "type": "string"
          }
        }
      },
      "SessionStatusResponse": {
        "required": [
          "isAuthenticated",
          "authMethod",
          "vaultUnlocked",
          "setupComplete"
        ],
        "type": "object",
        "properties": {
          "isAuthenticated": {
            "type": "boolean"
          },
          "authMethod": {
            "type": [
              "null",
              "string"
            ]
          },
          "vaultUnlocked": {
            "type": "boolean"
          },
          "setupComplete": {
            "type": "boolean"
          }
        }
      },
      "SetupStatusResponse": {
        "required": [
          "isComplete",
          "currentStep",
          "completedSteps",
          "updatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "isComplete": {
            "type": "boolean"
          },
          "currentStep": {
            "type": "string"
          },
          "completedSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "VaultGenerateRecoveryKeyResponse": {
        "required": [
          "recoveryKey"
        ],
        "type": "object",
        "properties": {
          "recoveryKey": {
            "type": "string"
          }
        }
      },
      "VaultLockResponse": {
        "required": [
          "locked"
        ],
        "type": "object",
        "properties": {
          "locked": {
            "type": "boolean"
          }
        }
      },
      "VaultSetupRequest": {
        "required": [
          "recoveryKey",
          "prfWrapAttempted",
          "prfOutputBase64",
          "passkeyCredentialId"
        ],
        "type": "object",
        "properties": {
          "recoveryKey": {
            "type": "string"
          },
          "prfWrapAttempted": {
            "type": "boolean"
          },
          "prfOutputBase64": {
            "type": [
              "null",
              "string"
            ]
          },
          "passkeyCredentialId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "VaultStatusResponse": {
        "required": [
          "lockState",
          "isVaultConfigured",
          "hasPasskey",
          "prfWrapAvailable",
          "serviceSyncVaultReady",
          "bootstrapCredentialsActive"
        ],
        "type": "object",
        "properties": {
          "lockState": {
            "type": "string"
          },
          "isVaultConfigured": {
            "type": "boolean"
          },
          "hasPasskey": {
            "type": "boolean"
          },
          "prfWrapAvailable": {
            "type": "boolean"
          },
          "serviceSyncVaultReady": {
            "type": "boolean"
          },
          "bootstrapCredentialsActive": {
            "type": "boolean"
          }
        }
      },
      "VaultUnlockRequest": {
        "required": [
          "recoveryKey"
        ],
        "type": "object",
        "properties": {
          "recoveryKey": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Setup"
    },
    {
      "name": "Settings"
    },
    {
      "name": "Activity"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Vault"
    }
  ]
}