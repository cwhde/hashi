<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hashi.Api</RootNamespace>
    <AssemblyName>Hashi.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hashi.Core\Hashi.Core.csproj" />
    <ProjectReference Include="..\Hashi.Infrastructure\Hashi.Infrastructure.csproj" />
    <ProjectReference Include="..\Hashi.Contracts\Hashi.Contracts.csproj" />
  </ItemGroup>

  <Target Name="PublishFrontend" BeforeTargets="Build" Condition="'$(SkipFrontendBuild)' != 'true' And Exists('..\..\web\package.json') And Exists('..\..\web\build\index.html')">
    <Message Importance="high" Text="Using existing web/build output. Run 'pnpm run build' in web/ to refresh." />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="PublishFrontend" Condition="'$(SkipFrontendBuild)' != 'true' And Exists('..\..\web\package.json') And !Exists('..\..\web\build\index.html')">
    <Exec Command="pnpm install --no-frozen-lockfile" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" />
    <Exec Command="pnpm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" />
  </Target>

  <ItemGroup>
    <Content Include="..\..\web\build\**\*" CopyToOutputDirectory="PreserveNewest" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\..\web\build')" />
    <Content Include="..\..\agents\pulse\install.sh" Link="content\pulse\install.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
