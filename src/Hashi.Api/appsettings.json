{
  "ConnectionStrings": {
    "Hashi": "Host=postgres;Port=5432;Database=hashi;Username=hashi;Password=hashi"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Hashi": {
    "ForwardAuthFailurePolicy": "closed",
    "Ports": {
      "Admin": 8080,
      "PublicDashboard": 8081,
      "PublicStatus": 8082
    },
    "ForwardAuth": {
      "TrustedProxyCidrs": [
        "127.0.0.0/8",
        "::1/128",
        "172.16.0.0/12"
      ]
    },
    "WebAuthn": {
      "ServerDomain": "localhost",
      "Origin": "http://localhost:8080",
      "EnablePrfExtension": true
    },
    "ServiceSyncVaultKey": ""
  }
}
